# Large source art lives in Git LFS. Packed web assets (web/public/assets, each
# file < 600 KB) are plain git so every host, Render included, gets them on clone.
art-src/** filter=lfs diff=lfs merge=lfs -text
marketing/** filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.sh text eol=lf
